# Copy to .env and fill in your own keys. Never commit .env.
# TRENCHNET loads these via trenchnet.secrets (never logs values).

# Helius (primary wallet history + optional RPC)
HELIUS_API_KEY=
HELIUS_RPC_URL=

# Birdeye (token price / OHLCV / wallet PnL on free tier)
BIRDEYE_API_KEY=

# Optional — leave blank if unused
QUICKNODE_RPC_URL=
PUMPFUN_JWT=
TYPESAFE_API_KEY=
FCC_API_KEY=
