# Copy to .env and fill in your own keys. Never commit .env.
# TRENCHNET loads these via trenchnet.secrets (never logs values).

# Helius (primary wallet history + optional RPC)
HELIUS_API_KEY=
HELIUS_RPC_URL=

# Birdeye (token price / OHLCV / wallet PnL on free tier)
BIRDEYE_API_KEY=

# Optional — leave blank if unused
QUICKNODE_RPC_URL=
PUMPFUN_JWT=
TYPESAFE_API_KEY=
FCC_API_KEY=

# Optional public Solana address for read-only My Wallet card + dry-run (local .env only)
MY_WALLET_ADDRESS=

# LIVE burner wallet secret — paste yourself. NEVER commit. NEVER share.
# Accepts Phantom/MetaMask base58 OR Solana CLI JSON byte array, e.g. [1,2,3,...]
# Prefer a fresh burner. Agents must not read this value.
TRENCHNET_WALLET_KEY=
